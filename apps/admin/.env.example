# ==============================================================================
# QuizMania - Environment Variables Template
# Rotaract Club of Mapusa
# ==============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Subject to RLS - safe for Public Quiz App)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (BYPASSES RLS - PRIVATE ADMIN & SERVER SCORING ONLY)
# NEVER EXPOSE THIS KEY TO PUBLIC CLIENTS OR CODE COMMITTED TO FRONTEND BUNDLES
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Ports
PORT_ADMIN=3001
PORT_PUBLIC=3000
