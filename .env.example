# ==============================================================================
# QuizMania - Environment Variables Template
# Rotaract Club of Mapusa
# ==============================================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anonymous Key (Subject to RLS - safe for Public Quiz App & browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Service Role Secret Key (BYPASSES RLS - PRIVATE ADMIN & SERVER OPERATIONS ONLY)
# NEVER EXPOSE THIS KEY TO BROWSER / CLIENT COMPONENTS, NEXT_PUBLIC_* VARS, OR COMMITTED CODE
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Ports
PORT_ADMIN=3011
PORT_PUBLIC=3010
